<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Body"
            android:text="@string/phone_intro" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/start_stop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/phone_start"
            android:textSize="19sp" />

        <!-- Step 1: notification access -->
        <TextView
            style="@style/Heading"
            android:text="@string/phone_step_listener" />

        <TextView
            style="@style/Body"
            android:text="@string/phone_step_listener_text" />

        <TextView
            android:id="@+id/listener_state"
            style="@style/State" />

        <Button
            android:id="@+id/open_listener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_open_listener" />

        <Button
            android:id="@+id/open_app_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_open_app_info" />

        <!-- Step 2: pairing -->
        <TextView
            style="@style/Heading"
            android:text="@string/phone_step_code" />

        <TextView
            style="@style/Body"
            android:text="@string/phone_step_code_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/phone_code_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="6"
                android:textSize="22sp" />

            <Button
                android:id="@+id/code_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_code_save" />
        </LinearLayout>

        <!-- Step 3: calls -->
        <TextView
            style="@style/Heading"
            android:text="@string/phone_step_calls" />

        <TextView
            style="@style/Body"
            android:text="@string/phone_step_calls_text" />

        <TextView
            android:id="@+id/calls_state"
            style="@style/State" />

        <Button
            android:id="@+id/calls_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_calls_button" />

        <!-- Step 4: start navigation from the radio -->
        <TextView
            style="@style/Heading"
            android:text="@string/phone_step_navigation" />

        <TextView
            style="@style/Body"
            android:text="@string/phone_step_navigation_text" />

        <TextView
            android:id="@+id/overlay_state"
            style="@style/State" />

        <Button
            android:id="@+id/overlay_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_overlay_button" />

        <!-- Help -->
        <TextView
            style="@style/Heading"
            android:text="@string/phone_howto_title" />

        <TextView
            style="@style/Body"
            android:text="@string/phone_howto_text" />

        <TextView
            style="@style/Heading"
            android:text="@string/phone_apk_title" />

        <TextView
            style="@style/Body"
            android:text="@string/phone_apk_text" />

        <TextView
            android:id="@+id/apk_urls"
            style="@style/State"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <Button
            android:id="@+id/switch_mode"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/switch_mode" />
    </LinearLayout>
</ScrollView>
